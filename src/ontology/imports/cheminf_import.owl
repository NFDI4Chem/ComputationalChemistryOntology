AnnotationAssertion(rdfs:label resource:CHEMINF_000129 "bond multiplicity")
SubClassOf(resource:CHEMINF_000129 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000130 (bond multiplicity descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000130 "A bond multiplicity descriptor is a chemical descriptor that in primitive cases is defined as half of the difference between the number of bonding and antibonding electrons in a particular system, but may also be defined with relation to the strength of a single bond.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000130 "bond multiplicity descriptor")
