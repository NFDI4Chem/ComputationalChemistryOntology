AnnotationAssertion(cheminf:short_name resource:CHEMINF_001502 "bondPartialSigmaCharge")
AnnotationAssertion(rdfs:label resource:CHEMINF_001502 "bond partial sigma charge"@en)
SubClassOf(resource:CHEMINF_001502 resource:CHEMINF_000087)

