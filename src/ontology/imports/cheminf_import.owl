# Class: resource:CHEMINF_000060 (dimensional extent descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000060 "A dimensional extent descriptor is a physical property descriptor which describes some measurable length, area or volume aspect of a chemical entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000060 "dimensional extent descriptor")
SubClassOf(resource:CHEMINF_000060 resource:CHEMINF_000093)

# Class: resource:CHEMINF_000061 (identifying descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000061 "An identifying descriptor is a chemical descriptor which provides an identifier for the chemical entity it is about, which in most cases should aim to be unique and easy to use as an unambiguous reference for the chemical entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000061 "identifying descriptor")
SubClassOf(resource:CHEMINF_000061 resource:CHEMINF_000123)

# Class: resource:CHEMINF_000062 (bond order descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000062 "A bond order descriptor is a descriptor associated with a bond in a chemical entity which indicates the order of the bond (single, double or triple).")
AnnotationAssertion(rdfs:label resource:CHEMINF_000062 "bond order descriptor")
