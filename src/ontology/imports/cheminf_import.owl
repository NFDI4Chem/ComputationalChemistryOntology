AnnotationAssertion(rdfs:comment resource:CHEMINF_000481 "not transitive, obviously")
AnnotationAssertion(rdfs:label resource:CHEMINF_000481 "similar to")
SubObjectPropertyOf(resource:CHEMINF_000481 resource:CHEMINF_000479)

# Object Property: resource:CHEMINF_000482 (similar to by PubChem 2D similarity algorithm)

AnnotationAssertion(obo:IAO_0000115 resource:CHEMINF_000482 "Has a Tanimoto score with the counterpart molecular entity of more than 0.9, based on the PubChem fingerprint specification.")
AnnotationAssertion(rdfs:comment resource:CHEMINF_000482 "http://pubchem.ncbi.nlm.nih.gov/help.html#tanimoto")
AnnotationAssertion(rdfs:label resource:CHEMINF_000482 "similar to by PubChem 2D similarity algorithm")
SubObjectPropertyOf(resource:CHEMINF_000482 resource:CHEMINF_000481)

# Object Property: resource:CHEMINF_000483 (similar to by PubChem 3D similarity algorithm)

AnnotationAssertion(obo:IAO_0000115 resource:CHEMINF_000483 "Has a 3D Tanimoto score with the counterpart molecule where the 3D shape similarity for the two is greater than 0.795 and the 3D feature score is greater than 0.495 or there are no features and the 3D shape similarity is greater than 0.925, where the shape similarity ST is calculated by ST=VAB/(VAA+VBB-VAB), where VAA and VBB are self-overlap volume of conformers A and B, and VAB is the common overlap volume between them and the feature score CT is calculated by CT=sum(VfAB)/(sum(VfAA)+sum(VfBB)-sum(VfAB)), where the superscript f indicates any of the six independent fictitious feature atom types, VfAA and VfBB are the respective self-overlap volumes of conformers A and B for feature atom type f, and VfAB is the overlap volume of conformers A and B for feature type f.")
AnnotationAssertion(rdfs:comment resource:CHEMINF_000483 "http://dx.doi.org/10.1186/1758-2946-3-32")
AnnotationAssertion(rdfs:label resource:CHEMINF_000483 "similar to by PubChem 3D similarity algorithm")
SubObjectPropertyOf(resource:CHEMINF_000483 resource:CHEMINF_000481)

