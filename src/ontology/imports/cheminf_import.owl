AnnotationAssertion(bibo:doi resource:CHEMINF_001544 "http://dx.doi.org/10.1002/ange.19850970818")
AnnotationAssertion(cheminf:short_name resource:CHEMINF_001544 "partialPiCharge")
AnnotationAssertion(rdfs:comment resource:CHEMINF_001544 "Other short_name: pepe.")
AnnotationAssertion(rdfs:label resource:CHEMINF_001544 "partial pi charge"@en)
SubClassOf(resource:CHEMINF_001544 resource:CHEMINF_000087)

# Class: resource:CHEMINF_001545 (partial sigma charge)

AnnotationAssertion(dcterms:description resource:CHEMINF_001545 "Descriptor that calculates sigma partial charges in sigma-bonded systems (PEOE) of an heavy atom based on Gasteiger Marsili.")
AnnotationAssertion(bibo:doi resource:CHEMINF_001545 "http://dx.doi.org/10.1016/0040-4020(80)80168-2")
AnnotationAssertion(cheminf:short_name resource:CHEMINF_001545 "partialSigmaCharge")
AnnotationAssertion(rdfs:label resource:CHEMINF_001545 "partial sigma charge"@en)
SubClassOf(resource:CHEMINF_001545 resource:CHEMINF_000087)

# Class: resource:CHEMINF_001546 (pi electronegativity)

AnnotationAssertion(dcterms:description resource:CHEMINF_001546 "Descriptor that returns the pi electronegativity for a given atom.")
AnnotationAssertion(cheminf:short_name resource:CHEMINF_001546 "piElectronegativity")
AnnotationAssertion(rdfs:comment resource:CHEMINF_001546 "Pi electronegativity is given by X = a + b q + c ( q 2 ) , where a, b and c are Gasteiger Marsili parameters, and q is the sigma charge. Other short_name: elecPiA.")
AnnotationAssertion(rdfs:label resource:CHEMINF_001546 "pi electronegativity"@en)
SubClassOf(resource:CHEMINF_001546 resource:CHEMINF_000087)


