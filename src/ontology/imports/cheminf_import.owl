# Class: resource:CHEMINF_000250 (solvation enthalpy descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000250 "The molecular entity solvation enthalpy descriptor reflects the enthalpy associated with the solvation of the molecular entity in question. This could be measured or calculated in vacuo or in a specific solvent, at a particular temperature and pressure. Depends on molecular conformation when computed.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000250 "solvation enthalpy descriptor")
SubClassOf(resource:CHEMINF_000250 resource:CHEMINF_000065)
