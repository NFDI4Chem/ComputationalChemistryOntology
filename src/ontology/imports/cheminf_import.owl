# Class: resource:CHEMINF_000431 (weighted quantitative estimate of drug-likeness)

AnnotationAssertion(obo:IAO_0000115 resource:CHEMINF_000431 "A descriptor which gives a quantitative estimate of drug likeness according to the procedure outlined in Bickerton et al., 2012.

http://www.ncbi.nlm.nih.gov/pubmed/22270643
Nat Chem. 2012 Jan 24;4(2):90-8. doi: 10.1038/nchem.1243.
Quantifying the chemical beauty of drugs.
Bickerton GR, Paolini GV, Besnard J, Muresan S, Hopkins AL.")
AnnotationAssertion(obo:IAO_0000118 resource:CHEMINF_000431 "QED weighted")
AnnotationAssertion(rdfs:label resource:CHEMINF_000431 "weighted quantitative estimate of drug-likeness"@en)
SubClassOf(resource:CHEMINF_000431 resource:CHEMINF_000025)

# Class: resource:CHEMINF_000432 (freezing point descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000432 "A descriptor that indicates the temperature at which a chemical substance undergoes a state transition from gas or liquid to solid, under standard conditions.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000432 "freezing point descriptor"@en)
SubClassOf(resource:CHEMINF_000432 resource:CHEMINF_000025)
SubClassOf(resource:CHEMINF_000432 resource:CHEMINF_000513)

# Class: resource:CHEMINF_000433 (Henry's Law constant)

AnnotationAssertion(dcterms:description resource:CHEMINF_000433 "Henry's law, formulated by William Henry in 1803, states \"At a constant temperature, the amount of a given gas that dissolves in a given type and volume of liquid is directly proportional to the partial pressure of that gas in equilibrium with that liquid.\" Henry's law can be put into mathematical terms (at constant temperature) as
    p = kHc
where p is the partial pressure of the solute in the gas above the solution, c is the concentration of the solute and kH is a constant with the dimensions of pressure divided by concentration. The constant, known as the Henry's law constant, depends on the solute, the solvent and the temperature.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000433 "Henry's Law constant"@en)
SubClassOf(resource:CHEMINF_000433 resource:CHEMINF_000025)
SubClassOf(resource:CHEMINF_000433 resource:CHEMINF_000513)

# Class: resource:CHEMINF_000434 (atmospheric OH rate constant)

AnnotationAssertion(dcterms:description resource:CHEMINF_000434 "A physical descriptor for the rate constant of a reaction of a chemical entity with OH. This is used to describe the atmospheric behaviour (i.e. stability) of the entity. ")
AnnotationAssertion(rdfs:label resource:CHEMINF_000434 "atmospheric OH rate constant"@en)
SubClassOf(resource:CHEMINF_000434 resource:CHEMINF_000025)
SubClassOf(resource:CHEMINF_000434 resource:CHEMINF_000513)

# Class: resource:CHEMINF_000435 (upper explosive limit descriptor)

