# Class: resource:CHEMINF_000104 (molecular QSAR descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000104 "A molecular QSAR descriptor is a OSAR descriptor which gives a quantitative value to some aspect of a molecular entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000104 "molecular QSAR descriptor")
SubClassOf(resource:CHEMINF_000104 resource:CHEMINF_000064)
SubClassOf(resource:CHEMINF_000104 resource:CHEMINF_000065)

# Class: resource:CHEMINF_000105 (cycle basis)

AnnotationAssertion(dcterms:description resource:CHEMINF_000105 "The cycle basis of a molecular structure is the smallest set of cycles (closed paths) formed in the graph representation of the structure, from which all other cycles can be computed.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000105 "cycle basis")
SubClassOf(resource:CHEMINF_000105 resource:CHEMINF_000085)

# Class: resource:CHEMINF_000106 (systematic name)

AnnotationAssertion(dcterms:description resource:CHEMINF_000106 "A systematic name is a molecular entity name which is formulated systematically from the structure of the molecular entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000106 "systematic name")
SubClassOf(resource:CHEMINF_000106 resource:CHEMINF_000043)

# Class: resource:CHEMINF_000107 (IUPAC name)

AnnotationAssertion(dcterms:description resource:CHEMINF_000107 "An IUPAC name is a systematic name which is formulated according to the rules and recommendations for chemical nomenclature set out by the International Union of Pure and Applied Chemistry (IUPAC).")
AnnotationAssertion(rdfs:label resource:CHEMINF_000107 "IUPAC name")
SubClassOf(resource:CHEMINF_000107 resource:CHEMINF_000106)

# Class: resource:CHEMINF_000108 (atomic quality)

