AnnotationAssertion(rdfs:label resource:CHEMINF_000439 "relative density descriptor"@en)
SubClassOf(resource:CHEMINF_000439 resource:CHEMINF_000025)
SubClassOf(resource:CHEMINF_000439 resource:CHEMINF_000513)

# Class: resource:CHEMINF_000440 (vapor density descriptor)

