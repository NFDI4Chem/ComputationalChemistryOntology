# Class: resource:CHEMINF_000115 (aromaticity)

AnnotationAssertion(dcterms:description resource:CHEMINF_000115 "Aromaticity is a molecular entity quality that inheres in a conjugated ring of unsaturated bonds, lone pairs, or empty orbitals that exhibit a stabilization stronger than would be expected by the stabilization of conjugation alone.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000115 "aromaticity")
SubClassOf(resource:CHEMINF_000115 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000116 (atomic connectivity index)

AnnotationAssertion(dcterms:description resource:CHEMINF_000116 "An atomic connectivity index is an atomic descriptor that is a measure of atomic connectivity, which can take various forms (e.g. zero-order, or first-order).")
AnnotationAssertion(rdfs:label resource:CHEMINF_000116 "atomic connectivity index")
SubClassOf(resource:CHEMINF_000116 resource:CHEMINF_000093)
SubClassOf(resource:CHEMINF_000116 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))

# Class: resource:CHEMINF_000117 (Wiener path number)

AnnotationAssertion(dcterms:description resource:CHEMINF_000117 "Half the sum of all the distance matrix entries, topological index of atom-atom distances.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000117 "Wiener path number")
SubClassOf(resource:CHEMINF_000117 resource:CHEMINF_000092)

# Class: resource:CHEMINF_000118 (formal charge descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000118 "The formal charge gives the charge assigned to an atom in a molecule, assuming that electrons in a chemical bond are shared equally between atoms, regardless of relative electronegativity.
The formal charge of any atom in a molecule can be calculated by the following equation: FC = number of valence electrons of the atom in isolation (atom in ground state) - number of non-bonding electrons on this atom in the molecule - half the total number of electrons shared in covalent bonds with other atoms in the molecule. [source:wikipedia]")
AnnotationAssertion(rdfs:label resource:CHEMINF_000118 "formal charge descriptor")
SubClassOf(resource:CHEMINF_000118 resource:CHEMINF_000131)
SubClassOf(resource:CHEMINF_000118 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))

# Class: resource:CHEMINF_000119 (partial charge descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000119 "A partial charge descriptor gives the charge with an absolute value of less than one elementary charge unit (that is, smaller than the charge of the electron). [source:wikipedia]")
AnnotationAssertion(rdfs:label resource:CHEMINF_000119 "partial charge descriptor")
SubClassOf(resource:CHEMINF_000119 resource:CHEMINF_000131)
SubClassOf(resource:CHEMINF_000119 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))

# Class: resource:CHEMINF_000120 (charge)

AnnotationAssertion(dcterms:description resource:CHEMINF_000120 "Charge is a quality that inheres in a molecular entity by virtue of the overall electric charge of the molecule, which is due to a comparison between the total number of electrons and the total number of protons.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000120 "charge")
SubClassOf(resource:CHEMINF_000120 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000121 (electronegativity)

AnnotationAssertion(dcterms:description resource:CHEMINF_000121 "Electronegativity is an atomic quality that describes its power to attract electrons to itself [source:IUPAC Gold Book - http://goldbook.iupac.org/E01990.html]")
AnnotationAssertion(rdfs:label resource:CHEMINF_000121 "electronegativity")
SubClassOf(resource:CHEMINF_000121 resource:CHEMINF_000404)

# Class: resource:CHEMINF_000122 (electronegativity descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000122 "An electronegativity descriptor is a chemical descriptor that is about the electronegativity quality of an atom.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000122 "electronegativity descriptor")
SubClassOf(resource:CHEMINF_000122 resource:CHEMINF_000087)
SubClassOf(resource:CHEMINF_000122 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))
SubClassOf(resource:CHEMINF_000122 ObjectSomeValuesFrom(resource:CHEMINF_000143 resource:CHEMINF_000121))

# Class: resource:CHEMINF_000123 (chemical descriptor)

