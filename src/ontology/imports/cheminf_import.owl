# Class: resource:CHEMINF_000182 (Petitjean Topological Shape Index)

AnnotationAssertion(dcterms:description resource:CHEMINF_000182 "A measure of the anisotropy in a molecule (as per Petitjean et al)")
AnnotationAssertion(rdfs:label resource:CHEMINF_000182 "Petitjean Topological Shape Index"@en)
SubClassOf(resource:CHEMINF_000182 resource:CHEMINF_000185)

# Class: resource:CHEMINF_000183 (Petitjean Geometric Shape Index)

AnnotationAssertion(dcterms:description resource:CHEMINF_000183 "A measure of the anisotropy in a molecule (as per Bath et al)")
AnnotationAssertion(rdfs:label resource:CHEMINF_000183 "Petitjean Geometric Shape Index"@en)
SubClassOf(resource:CHEMINF_000183 resource:CHEMINF_000185)

# Class: resource:CHEMINF_000184 (Petitjean number)

AnnotationAssertion(dcterms:description resource:CHEMINF_000184 "the eccentricity of a vertex corresponds to the distance from that vertex to the most remote vertex in the graph. The distance is obtained from the distance matrix as the count of edges between the two vertices. If r i is the largest matrix entry in row i of the distance matrix D, then the radius is defined as the smallest of the r i . The graph diameter D is defined as the largest vertex eccentricity in the graph. Petitjean Number is the value of ( diameter - radius ) diameter .")
AnnotationAssertion(cheminf-core:short_name resource:CHEMINF_000184 "petitjeanNumber")
AnnotationAssertion(rdfs:label resource:CHEMINF_000184 "Petitjean number"@en)
SubClassOf(resource:CHEMINF_000184 resource:CHEMINF_000092)

# Class: resource:CHEMINF_000185 (Petitjean Shape Index)

AnnotationAssertion(dcterms:description resource:CHEMINF_000185 "A measure of the anisotropy in a molecule")
AnnotationAssertion(cheminf-core:short_name resource:CHEMINF_000185 "petitjeanShapeIndex")
AnnotationAssertion(rdfs:label resource:CHEMINF_000185 "Petitjean Shape Index"@en)
SubClassOf(resource:CHEMINF_000185 resource:CHEMINF_000092)

# Class: resource:CHEMINF_000186 (XLogP descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000186 "A LogP descriptor based on the atom-type method described in Wang, R., Fu, Y., and Lai, L.. A New Atom-Additive Method for Calculating Partition Coefficients, Journal of Chemical Information and Computer Sciences. vol. 37. 1997, pp. 615-621.")
AnnotationAssertion(cheminf-core:short_name resource:CHEMINF_000186 "XLogP")
AnnotationAssertion(rdfs:label resource:CHEMINF_000186 "XLogP descriptor"@en)
SubClassOf(resource:CHEMINF_000186 resource:CHEMINF_000251)

# Class: resource:CHEMINF_000187 (MLogP descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000187 "A LogP descriptor based on a simple equation using the number of carbons and hetero atoms.")
AnnotationAssertion(cheminf-core:short_name resource:CHEMINF_000187 "MannholdLogP")
AnnotationAssertion(rdfs:label resource:CHEMINF_000187 "MLogP descriptor"@en)
SubClassOf(resource:CHEMINF_000187 resource:CHEMINF_000251)

