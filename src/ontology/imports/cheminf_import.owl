AnnotationAssertion(rdfs:label resource:CHEMINF_000435 "upper explosive limit descriptor"@en)
SubClassOf(resource:CHEMINF_000435 resource:CHEMINF_000025)
SubClassOf(resource:CHEMINF_000435 resource:CHEMINF_000513)

