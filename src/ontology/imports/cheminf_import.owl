AnnotationAssertion(rdfs:label resource:CHEMINF_001103 "photoreactivity")
SubClassOf(resource:CHEMINF_001103 resource:CHEMINF_001102)

# Class: resource:CHEMINF_001104 (connectivity SMILES descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_001104 "A connectivity SMILES descriptor is a SMILES descriptor that does not include any stereochemical or isotopic information.")
AnnotationAssertion(rdfs:label resource:CHEMINF_001104 "connectivity SMILES descriptor")
SubClassOf(resource:CHEMINF_001104 resource:CHEMINF_000018)

