AnnotationAssertion(cheminf:short_name resource:CHEMINF_001501 "bondPartialPiCharge")
AnnotationAssertion(rdfs:label resource:CHEMINF_001501 "bond partial pi charge"@en)
SubClassOf(resource:CHEMINF_001501 resource:CHEMINF_000087)

