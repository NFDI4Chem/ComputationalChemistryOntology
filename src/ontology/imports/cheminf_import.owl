AnnotationAssertion(cheminf:short_name resource:CHEMINF_001507 "chiCluster")
AnnotationAssertion(rdfs:comment resource:CHEMINF_001507 " It utilizes the graph isomorphism code of the CDK to find fragments matching SMILES strings representing the fragments corresponding to each type of chain.")
AnnotationAssertion(rdfs:label resource:CHEMINF_001507 "chi cluster indices"@en)
SubClassOf(resource:CHEMINF_001507 resource:CHEMINF_000092)

