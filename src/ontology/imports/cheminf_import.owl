AnnotationAssertion(rdfs:label resource:CHEMINF_000440 "vapor density descriptor"@en)
SubClassOf(resource:CHEMINF_000440 resource:CHEMINF_000025)
SubClassOf(resource:CHEMINF_000440 resource:CHEMINF_000513)

