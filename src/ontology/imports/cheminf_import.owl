# Class: resource:CHEMINF_000096 (atomic valence)

AnnotationAssertion(dcterms:description resource:CHEMINF_000096 "Atomic valence is an atomic descriptor that specifies the maximum number of univalent atoms (originally hydrogen or chlorine atoms) which may combine with an atom of the element under consideration, or with a fragment, or for which an atom of this element can be substituted [source: IUPAC Gold Book - http://goldbook.iupac.org/V06588.html]")
AnnotationAssertion(rdfs:label resource:CHEMINF_000096 "atomic valence")
SubClassOf(resource:CHEMINF_000096 resource:CHEMINF_000087)
SubClassOf(resource:CHEMINF_000096 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))

# Class: resource:CHEMINF_000097 (atomic hardness descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000097 "An atomic hardness descriptor is an atomic descriptor that estimates the difference between the ionization potential and the electron affinity of a given atom.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000097 "atomic hardness descriptor")
SubClassOf(resource:CHEMINF_000097 resource:CHEMINF_000094)
SubClassOf(resource:CHEMINF_000097 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))

# Class: resource:CHEMINF_000098 (valency)

AnnotationAssertion(dcterms:description resource:CHEMINF_000098 "Valency is an atomic quality of the number of chemical bonds formed by the atom.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000098 "valency")
SubClassOf(resource:CHEMINF_000098 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000099 (atomic softness descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000099 "An atomic softness descriptor is an atomic descriptor which is about the charge delocalizing ability of a given atom.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000099 "atomic softness descriptor")
SubClassOf(resource:CHEMINF_000099 resource:CHEMINF_000094)
SubClassOf(resource:CHEMINF_000099 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))

# Class: resource:CHEMINF_000100 (MOLfile format specification)

AnnotationAssertion(dcterms:description resource:CHEMINF_000100 "The MOLfile atomic connectivity molecular structure encoding format specification may be found described at http://en.wikipedia.org/wiki/Chemical_table_file#Molfiles. It is composed primarily of a connection table (atoms and bonds); hydrogen may be implicit or explicit.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000100 "MOLfile format specification")
SubClassOf(resource:CHEMINF_000100 resource:CHEMINF_000035)

# Class: resource:CHEMINF_000101 (chemical substance quality)

AnnotationAssertion(dcterms:description resource:CHEMINF_000101 "A chemical substance quality is a quality that inheres in an aggregate molecular substance, such as a portion of solid or liquid matter.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000101 "chemical substance quality")
SubClassOf(resource:CHEMINF_000101 resource:CHEMINF_000086)
SubClassOf(resource:CHEMINF_000101 ObjectSomeValuesFrom(obo:RO_0000052 resource:CHEMINF_000266))

# Class: resource:CHEMINF_000102 (crystal structure)

AnnotationAssertion(dcterms:description resource:CHEMINF_000102 "A crystal structure is a chemical substance quality which inheres in a crystalline solid or liquid crystal substance by virtue of the way the molecules are ordered within the crystal.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000102 "crystal structure")
SubClassOf(resource:CHEMINF_000102 resource:CHEMINF_000101)

# Class: resource:CHEMINF_000103 (software module to calculate a chemical descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000103 "A software module to calculate a chemical descriptor is software module that implements an algorithm which calculates a descriptor value for a chemical entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000103 "software module to calculate a chemical descriptor")
