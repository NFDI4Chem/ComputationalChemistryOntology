# Class: resource:CHEMINF_000248 (relative permittivity)

AnnotationAssertion(dcterms:description resource:CHEMINF_000248 "Relative permittivity is a chemical substance quality that reflects the ability of a medium composed of molecules of a given type to transmit an electric field.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000248 "relative permittivity")
SubClassOf(resource:CHEMINF_000248 resource:CHEMINF_000404)

# Class: resource:CHEMINF_000249 (solvation entropy descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000249 "The molecular entity solvation entropy descriptor reflects the entropy associated with the solvation of the molecular entity in question. This could be measured or calculated in vacuo or in a specific solvent, at a particular temperature and pressure. Depends on molecular conformation when computed.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000249 "solvation entropy descriptor")
SubClassOf(resource:CHEMINF_000249 resource:CHEMINF_000065)
SubClassOf(resource:CHEMINF_000249 resource:CHEMINF_000208)
