# Class: resource:CHEMINF_000067 (cyclicity)

AnnotationAssertion(dcterms:description resource:CHEMINF_000067 "cyclicity is a quality that inheres in a molecular entity by virtue of the presence of cycles in the connection of the atoms within the molecular entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000067 "cyclicity")
SubClassOf(resource:CHEMINF_000067 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000068 (functional group descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000068 "A functional group descriptor is a structural descriptor which describes specific groups of atoms within molecules that are responsible for the characteristic chemical reactions of those molecules.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000068 "functional group descriptor")
SubClassOf(resource:CHEMINF_000068 resource:CHEMINF_000065)
SubClassOf(resource:CHEMINF_000068 resource:CHEMINF_000085)

# Class: resource:CHEMINF_000069 (polarity)

AnnotationAssertion(dcterms:description resource:CHEMINF_000069 "Polarity is a quality that inheres in a molecular entity by virtue of whether or not the molecular entity has a separation of electric charge which leads to the molecule having an electric dipole.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000069 "polarity")
SubClassOf(resource:CHEMINF_000069 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000070 (polar)

AnnotationAssertion(dcterms:description resource:CHEMINF_000070 "Polar polarity is a quality that inheres in a molecular entity when the molecular entity is polar, i.e. does possess an electric dipole.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000070 "polar")
SubClassOf(resource:CHEMINF_000070 resource:CHEMINF_000069)
DisjointClasses(resource:CHEMINF_000070 resource:CHEMINF_000071)

# Class: resource:CHEMINF_000071 (nonpolar)

AnnotationAssertion(dcterms:description resource:CHEMINF_000071 "Nonpolar polarity is a quality which inheres in a molecular entity when the molecular entity does not possess an electrical dipole.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000071 "nonpolar")
SubClassOf(resource:CHEMINF_000071 resource:CHEMINF_000069)

# Class: resource:CHEMINF_000072 (cyclic)

AnnotationAssertion(dcterms:description resource:CHEMINF_000072 "Cyclic cyclicity inheres in a molecule when the atoms of the molecule do contain at least one cycle in the atom-atom connection paths (through bonds).")
AnnotationAssertion(rdfs:label resource:CHEMINF_000072 "cyclic")
SubClassOf(resource:CHEMINF_000072 resource:CHEMINF_000067)
DisjointClasses(resource:CHEMINF_000072 resource:CHEMINF_000073)

# Class: resource:CHEMINF_000073 (acyclic)

AnnotationAssertion(dcterms:description resource:CHEMINF_000073 "Acyclic cyclicity inheres in a molecule when the atoms within the molecule do not contain at least one cycle in the atom-atom connection paths (through the bonds).")
AnnotationAssertion(rdfs:label resource:CHEMINF_000073 "acyclic")
SubClassOf(resource:CHEMINF_000073 resource:CHEMINF_000067)

