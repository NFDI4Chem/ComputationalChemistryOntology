AnnotationAssertion(dcterms:description resource:CHEMINF_000076 "Aromatic aromaticity is a quality that inheres in a molecular entity when it possesses at least one ring that is aromatic.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000076 "aromatic")
