SubClassOf(resource:CHEMINF_000063 resource:CHEMINF_000000)

# Class: resource:CHEMINF_000064 (QSAR descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000064 "A Quantitative Structure Activity Relationship (QSAR) descriptor is a chemical descriptor which gives a numeric, quantitative value which is believed to be associated with some aspect of the chemical or biological activity of the chemical entity.")
AnnotationAssertion(oboInOwl:hasAlternativeId resource:CHEMINF_000064 "BODO:Descriptor")
AnnotationAssertion(rdfs:comment resource:CHEMINF_000064 "NOTE: QSAR descriptors are often just called 'chemical descriptor' or 'molecular descriptor' in the cheminformatics community.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000064 "QSAR descriptor")
SubClassOf(resource:CHEMINF_000064 resource:CHEMINF_000123)

# Class: resource:CHEMINF_000065 (molecular entity descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000065 "a molecular entity descriptor is a chemical descriptor that provides information about a molecular entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000065 "molecular entity descriptor")
