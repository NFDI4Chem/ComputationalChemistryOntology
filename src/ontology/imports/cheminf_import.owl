# Class: resource:CHEMINF_000519 (absolute configuration stereochemical descriptor)

AnnotationAssertion(dcterms:creator resource:CHEMINF_000519 <http://orcid.org/0000-0002-4378-6061>)
AnnotationAssertion(dcterms:date resource:CHEMINF_000519 "2022-07-11T08:01:45Z"^^xsd:dateTime)
AnnotationAssertion(dcterms:description resource:CHEMINF_000519 "The spatial arrangement of the atoms of a chiral molecular entity (or group) and its stereochemical description e.g. R or S.")
AnnotationAssertion(dcterms:source resource:CHEMINF_000519 "https://doi.org/10.1351/goldbook.A00020"^^xsd:anyURI)
AnnotationAssertion(rdfs:label resource:CHEMINF_000519 "absolute configuration stereochemical descriptor"@en)
SubClassOf(resource:CHEMINF_000519 resource:CHEMINF_000027)
SubClassOf(resource:CHEMINF_000519 ObjectSomeValuesFrom(resource:CHEMINF_000143 resource:CHEMINF_000074))

# Class: resource:CHEMINF_000520 (relative configuration stereochemical descriptor)

AnnotationAssertion(dcterms:creator resource:CHEMINF_000520 <http://orcid.org/0000-0002-4378-6061>)
AnnotationAssertion(dcterms:date resource:CHEMINF_000520 "2022-07-11T08:04:08Z"^^xsd:dateTime)
AnnotationAssertion(dcterms:description resource:CHEMINF_000520 "The configuration of any stereogenic (asymmetric) centre with respect to any other stereogenic centre contained within the same molecular entity. Unlike absolute configuration, relative configuration is reflection-invariant. Relative configuration, distinguishing diastereoisomers, may be denoted by the configurational descriptors R*, R* (or l) and R*, S* (or u) meaning, respectively, that the two centres have identical or opposite configurations. For molecules with more than two asymmetric centres the prefix rel- may be used in front of the name of one enantiomer where R and S have been used. If any centres have known absolute configuration then only R* and S* can be used for the relative configuration.")
AnnotationAssertion(dcterms:source resource:CHEMINF_000520 "https://doi.org/10.1351/goldbook.R05260"^^xsd:anyURI)
AnnotationAssertion(rdfs:label resource:CHEMINF_000520 "relative configuration stereochemical descriptor"@en)
SubClassOf(resource:CHEMINF_000520 resource:CHEMINF_000027)
SubClassOf(resource:CHEMINF_000520 ObjectSomeValuesFrom(resource:CHEMINF_000143 resource:CHEMINF_000074))

# Class: resource:CHEMINF_000521 (double bond equivalent)

AnnotationAssertion(obo:IAO_0000118 resource:CHEMINF_000521 "DBE, degree/level of unsaturation, unsaturation index, index of hydrogen deficiency (IHD)")
AnnotationAssertion(dcterms:creator resource:CHEMINF_000521 <http://orcid.org/0000-0002-4378-6061>)
AnnotationAssertion(dcterms:date resource:CHEMINF_000521 "2022-07-11T08:07:03Z"^^xsd:dateTime)
AnnotationAssertion(dcterms:description resource:CHEMINF_000521 "The number of molecules of H2 that would have to be added to a molecule to convert all pi bonds to single bonds, and all rings to acyclic structures.")
AnnotationAssertion(dcterms:source resource:CHEMINF_000521 "http://www.chem.ucla.edu/~harding/IGOC/D/double_bond_equivalent.html"^^xsd:anyURI)
AnnotationAssertion(rdfs:label resource:CHEMINF_000521 "double bond equivalent"@en)
SubClassOf(resource:CHEMINF_000521 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000522 (smallest set of smallest rings)

AnnotationAssertion(obo:IAO_0000118 resource:CHEMINF_000522 "SSSR")
AnnotationAssertion(dcterms:creator resource:CHEMINF_000522 <http://orcid.org/0000-0002-4378-6061>)
AnnotationAssertion(dcterms:date resource:CHEMINF_000522 "2022-07-11T08:18:30Z"^^xsd:dateTime)
AnnotationAssertion(dcterms:description resource:CHEMINF_000522 "The Smallest Set of Smallest Rings (SSSR) is a subset of cycles within a molecular graph (ring). SSSR was the first widely-used cycle set to classify cyclic molecules in cheminformatics. It offers a limited solution to the problem of molecular cycle perception. Unlike the set of all cycles, an SSSR can filter useless or interfering envelope cycles, but offers no guarantee of uniqueness. A given molecular graph can produce multiple SSSRs with no constraints on which one will be obtained.")
AnnotationAssertion(dcterms:source resource:CHEMINF_000522 "https://depth-first.com/articles/2020/08/31/a-smallest-set-of-smallest-rings/"^^xsd:anyURI)
AnnotationAssertion(rdfs:label resource:CHEMINF_000522 "smallest set of smallest rings"@en)
SubClassOf(resource:CHEMINF_000522 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000523 (ACD/Labs index name)

AnnotationAssertion(obo:IAO_0000118 resource:CHEMINF_000523 "index name")
AnnotationAssertion(dcterms:creator resource:CHEMINF_000523 <http://orcid.org/0000-0002-4378-6061>)
AnnotationAssertion(dcterms:date resource:CHEMINF_000523 "2022-07-11T08:20:10Z"^^xsd:dateTime)
AnnotationAssertion(dcterms:description resource:CHEMINF_000523 "A molecular entity name that represents the name of a molecular structure determined by the naming algorithms developed by ACD/Labs.")
AnnotationAssertion(dcterms:source resource:CHEMINF_000523 "https://www.acdlabs.com/products/name/"^^xsd:anyURI)
AnnotationAssertion(rdfs:label resource:CHEMINF_000523 "ACD/Labs index name"@en)
SubClassOf(resource:CHEMINF_000523 resource:CHEMINF_000043)

# Class: resource:CHEMINF_000524 (InChI with fixedH layer)

AnnotationAssertion(dcterms:creator resource:CHEMINF_000524 <http://orcid.org/0000-0002-4378-6061>)
AnnotationAssertion(dcterms:date resource:CHEMINF_000524 "2022-07-11T08:22:02Z"^^xsd:dateTime)
AnnotationAssertion(dcterms:description resource:CHEMINF_000524 "An InChI descriptor that is not the standard and that is created with the fixedH layer option. The fixedH layer is appended to the standard InChI and lists the exact position of the tautomeric hydrogen atoms. It is useful when one wants to represent a specific tautomer of a given structure, because if the InChIs for the tautomers were created without the fixedH layer option, the normalization performed by the InChI generation program would result in these InChIs being identical.")
AnnotationAssertion(dcterms:source resource:CHEMINF_000524 "https://doi.org/10.1186%2Fs13321-015-0068-4"^^xsd:anyURI)
AnnotationAssertion(rdfs:label resource:CHEMINF_000524 "InChI with fixedH layer"@en)
SubClassOf(resource:CHEMINF_000524 resource:CHEMINF_000113)

