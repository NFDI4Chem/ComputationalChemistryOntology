AnnotationAssertion(cheminf:short_name resource:CHEMINF_001504 "bondSigmaElectronegativity")
AnnotationAssertion(rdfs:label resource:CHEMINF_001504 "bond sigma electronegativity"@en)
SubClassOf(resource:CHEMINF_001504 resource:CHEMINF_000087)

# Class: resource:CHEMINF_001505 (bonds to Atom)

AnnotationAssertion(dcterms:description resource:CHEMINF_001505 "Descriptor based on the number of bonds on the shortest path between two atoms (topological distance).")
AnnotationAssertion(cheminf:short_name resource:CHEMINF_001505 "bondsToAtom")
AnnotationAssertion(rdfs:comment resource:CHEMINF_001505 "This is the shortest distance between a pair of atoms in a graph, defined as the number of edges in the shortest path between the atom pair in the molecular graph.")
AnnotationAssertion(rdfs:label resource:CHEMINF_001505 "bonds to Atom"@en)
SubClassOf(resource:CHEMINF_001505 resource:CHEMINF_000092)

# Class: resource:CHEMINF_001506 (chi chain indices)

AnnotationAssertion(dcterms:description resource:CHEMINF_001506 "Evluates the simple and valence chi chain descriptors (Kier and Hall) of orders 3, 4, 5, 6 and 7. ")
AnnotationAssertion(cheminf:short_name resource:CHEMINF_001506 "chiChain")
AnnotationAssertion(rdfs:comment resource:CHEMINF_001506 "It utilizes the graph isomorphism code of the CDK to find fragments matching SMILES strings representing the fragments corresponding to each type of chain.")
AnnotationAssertion(rdfs:label resource:CHEMINF_001506 "chi chain indices"@en)
SubClassOf(resource:CHEMINF_001506 resource:CHEMINF_000092)

