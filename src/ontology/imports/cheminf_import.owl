# Class: resource:CHEMINF_000109 (trivial name)

AnnotationAssertion(dcterms:description resource:CHEMINF_000109 "A trivial name is a molecular entity name that is in common public use and may not be related to the structure of the molecular entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000109 "trivial name")
SubClassOf(resource:CHEMINF_000109 resource:CHEMINF_000043)

# Class: resource:CHEMINF_000110 (fused cycles)

AnnotationAssertion(dcterms:description resource:CHEMINF_000110 "The fused cycles in a molecular structure are those cycles from the cycle basis which share at least one bond.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000110 "fused cycles")
SubClassOf(resource:CHEMINF_000110 resource:CHEMINF_000065)
SubClassOf(resource:CHEMINF_000110 resource:CHEMINF_000085)

# Class: resource:CHEMINF_000111 (CML format specification)

AnnotationAssertion(dcterms:description resource:CHEMINF_000111 "A CML (Chemical Markup Language) file is an XML-based representation of the atomic connectivity of a molecular entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000111 "CML format specification")
SubClassOf(resource:CHEMINF_000111 resource:CHEMINF_000035)

# Class: resource:CHEMINF_000112 (atomic QSAR descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000112 "An atomic QSAR descriptor is a QSAR descriptor which gives a quantitative value to some aspect of an atom which is part of a molecular entity.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000112 "atomic QSAR descriptor")
SubClassOf(resource:CHEMINF_000112 resource:CHEMINF_000064)
SubClassOf(resource:CHEMINF_000112 resource:CHEMINF_000065)

# Class: resource:CHEMINF_000113 (InChI descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000113 "An InChI descriptor is a structure descriptor which conforms to the InChI format specification.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000113 "InChI descriptor")
