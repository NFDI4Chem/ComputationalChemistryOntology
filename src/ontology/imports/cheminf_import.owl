# Class: resource:CHEMINF_000020 (SMILES format specification)

AnnotationAssertion(dcterms:description resource:CHEMINF_000020 "The simplified molecular input line entry specification (SMILES) is a specification for unambiguously describing the structure of chemical molecules using short ASCII strings. SMILES strings can be imported by most molecule editors for conversion back into two-dimensional drawings or three-dimensional models of the molecules (source:wikipedia).")
AnnotationAssertion(rdfs:label resource:CHEMINF_000020 "SMILES format specification")
SubClassOf(resource:CHEMINF_000020 resource:CHEMINF_000035)

# Class: resource:CHEMINF_000021 (SMARTS format specification)

AnnotationAssertion(dcterms:description resource:CHEMINF_000021 "Smiles ARbitrary Target Specification (SMARTS) is a language for specifying substructural patterns in molecules. The SMARTS line notation is expressive and allows extremely precise and transparent substructural specification and atom typing (source:Wikipedia)")
AnnotationAssertion(rdfs:label resource:CHEMINF_000021 "SMARTS format specification")
SubClassOf(resource:CHEMINF_000021 resource:CHEMINF_000035)

