# Class: resource:CHEMINF_000216 (average molecular weight descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000216 "The mass of a molecule calculated using the average mass of each element weighted for its natural isotopic abundance. E.g., Carbon has two natural isotopes 12 and 13 with relative abundances of 98.9% and 1.1% to yield an average mass of 12.011 g/mol")
AnnotationAssertion(rdfs:label resource:CHEMINF_000216 "average molecular weight descriptor"@en)
SubClassOf(resource:CHEMINF_000216 resource:CHEMINF_000088)

# Class: resource:CHEMINF_000217 (exact mass descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000217 "an exact mass descriptor corresponds to the mass of the most intense molecule/ion peak in an MS spec, and when calculated denotes the mass of an ion or a molecule containing most likely isotopic composition for a single random molecule.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000217 "exact mass descriptor"@en)
SubClassOf(resource:CHEMINF_000217 resource:CHEMINF_000088)

# Class: resource:CHEMINF_000218 (monoisotopic mass descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000218 "The mass of a molecule calculated using the mass of the most abundant isotope of each element. E.g., Carbon has a monoisotopic mass of 12.000 g/mol.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000218 "monoisotopic mass descriptor"@en)
SubClassOf(resource:CHEMINF_000218 resource:CHEMINF_000088)

# Class: resource:CHEMINF_000219 (complexity descriptor)

