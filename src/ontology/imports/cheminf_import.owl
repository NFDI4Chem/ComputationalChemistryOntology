# Class: resource:CHEMINF_000400 (chemical graph)

AnnotationAssertion(dcterms:description resource:CHEMINF_000400 "A chemical graph is a structural descriptor in which the connectivity and constitution of the chemical entity are described in terms of a mathematical graph, usually with atoms as vertices and bonds as edges, but other variants exist.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000400 "chemical graph")
SubClassOf(resource:CHEMINF_000400 resource:CHEMINF_000085)

# Class: resource:CHEMINF_000401 (neutral charge)

AnnotationAssertion(dcterms:description resource:CHEMINF_000401 "Neutral charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing the same amount of electrons overall as protons, thus having an overall neutral charge.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000401 "neutral charge")
SubClassOf(resource:CHEMINF_000401 resource:CHEMINF_000120)

# Class: resource:CHEMINF_000402 (positive charge)

AnnotationAssertion(dcterms:description resource:CHEMINF_000402 "Positive charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing more protons overall than electrons, thus having an overall positive charge.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000402 "positive charge")
SubClassOf(resource:CHEMINF_000402 resource:CHEMINF_000120)

# Class: resource:CHEMINF_000403 (negative charge)

AnnotationAssertion(dcterms:description resource:CHEMINF_000403 "Negative charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing more electrons overall than protons, thus having an overall negative charge.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000403 "negative charge")
SubClassOf(resource:CHEMINF_000403 resource:CHEMINF_000120)

