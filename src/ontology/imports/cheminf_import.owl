# Class: resource:CHEMINF_000114 (MOLfile descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000114 "A MOLfile descriptor is a structure descriptor which conforms to the MOLfile format specification.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000114 "MOLfile descriptor")
