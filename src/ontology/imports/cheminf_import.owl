AnnotationAssertion(rdfs:label resource:CHEMINF_000236 "charge density")
SubClassOf(resource:CHEMINF_000236 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000237 (bond aromaticity descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000237 "A bond aromaticity descriptor is an aromaticity descriptor associated with a bond within a chemical entity which indicates whether that  bond belongs to an aromatic system.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000237 "bond aromaticity descriptor")
