AnnotationAssertion(rdfs:label resource:CHEMINF_000090 "atomic degree")
SubClassOf(resource:CHEMINF_000090 resource:CHEMINF_000209)
SubClassOf(resource:CHEMINF_000090 ObjectSomeValuesFrom(obo:IAO_0000136 obo:CHEBI_33250))

# Class: resource:CHEMINF_000091 (hybridization)

AnnotationAssertion(dcterms:description resource:CHEMINF_000091 "The quality of an atom that reflects the combination of its atomic orbitals to create bonding orbitals.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000091 "hybridization")
SubClassOf(resource:CHEMINF_000091 resource:CHEMINF_000031)

# Class: resource:CHEMINF_000092 (topological descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000092 "A topological descriptor is a chemical descriptor which pertains to spatial properties of a geometric object that are preserved under continuous deformations of objects, for example, deformations that involve stretching.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000092 "topological descriptor")
SubClassOf(resource:CHEMINF_000092 resource:CHEMINF_000123)

# Class: resource:CHEMINF_000093 (geometric descriptor)

AnnotationAssertion(dcterms:description resource:CHEMINF_000093 "A geometric descriptor is a descriptor that concerns information about size, shape, and relative position.")
AnnotationAssertion(rdfs:label resource:CHEMINF_000093 "geometric descriptor")
SubClassOf(resource:CHEMINF_000093 resource:CHEMINF_000123)

