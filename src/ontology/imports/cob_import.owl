AnnotationAssertion(obo:IAO_0000115 obo:PR_000018263 "An organic amino compound that consists of amino acid residues (unmodified amino-acid residues and/or modified amino-acid residues) linked by peptide bonds or derivatives of such bonds.")
AnnotationAssertion(rdfs:label obo:PR_000018263 "amino acid chain")
SubClassOf(obo:PR_000018263 obo:COB_0000013)

