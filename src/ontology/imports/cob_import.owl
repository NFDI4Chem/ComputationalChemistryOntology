AnnotationAssertion(rdfs:label obo:COB_0000116 "obsolete cellular membrane")
AnnotationAssertion(owl:deprecated obo:COB_0000116 "true"^^xsd:boolean)

# Class: obo:COB_0000122 (obsolete physical information carrier)

AnnotationAssertion(rdfs:label obo:COB_0000122 "obsolete physical information carrier")
AnnotationAssertion(owl:deprecated obo:COB_0000122 "true"^^xsd:boolean)

# Class: obo:COB_0000502 (characteristic)

AnnotationAssertion(rdfs:label obo:COB_0000502 "characteristic"@en)

# Class: obo:COB_0001000 (exposure of organism)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0001000 "A process during which an organism comes into contact with another entity."@en)
AnnotationAssertion(rdfs:label obo:COB_0001000 "exposure of organism"@en)
SubClassOf(obo:COB_0001000 obo:BFO_0000015)
SubClassOf(obo:COB_0001000 ObjectSomeValuesFrom(obo:RO_0000057 obo:COB_0000022))

# Class: obo:COB_0001300 (device)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0001300 "A processed material entity which is designed to be capable of a process."@en)
AnnotationAssertion(rdfs:label obo:COB_0001300 "device"@en)
SubClassOf(obo:COB_0001300 obo:COB_0000026)
SubClassOf(obo:COB_0001300 ObjectSomeValuesFrom(obo:RO_0002215 obo:BFO_0000015))

# Class: obo:ENVO_01000813 (geophysical entity)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01000813 "A material part of an astronomical body.")
AnnotationAssertion(rdfs:label obo:ENVO_01000813 "geophysical entity"@en)
SubClassOf(obo:ENVO_01000813 obo:BFO_0000040)

# Class: obo:ENVO_01001110 (ecosystem)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001110 "An environmental system which includes both living and non-living components.")
AnnotationAssertion(rdfs:label obo:ENVO_01001110 "ecosystem"@en)
SubClassOf(obo:ENVO_01001110 obo:BFO_0000040)

# Class: obo:ENVO_02500000 (environmental system process)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_02500000 "A process in which includes the components of an environmental system as participants.")
AnnotationAssertion(rdfs:label obo:ENVO_02500000 "environmental system process"@en)
SubClassOf(obo:ENVO_02500000 obo:BFO_0000015)

# Class: obo:GO_0003674 (gene product or complex activity)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0003674 "A molecular process that can be carried out by the action of a single macromolecular machine, usually via direct physical interactions with other molecular entities. Function in this sense denotes an action, or activity, that a gene product (or a complex) performs.")
AnnotationAssertion(obo:IAO_0000116 obo:GO_0003674 "This is the same as GO molecular function"@en)
AnnotationAssertion(rdfs:label obo:GO_0003674 "gene product or complex activity"@en)
SubClassOf(obo:GO_0003674 obo:BFO_0000015)

# Class: obo:GO_0005575 (cellular_component)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0005575 "A location, relative to cellular compartments and structures, occupied by a macromolecular machine. There are three types of cellular components described in the gene ontology: (1) the cellular anatomical entity where a gene product carries out a molecular function (e.g., plasma membrane, cytoskeleton) or membrane-enclosed compartments (e.g., mitochondrion); (2) virion components, where viral proteins act, and (3) the stable macromolecular complexes of which gene product are parts (e.g., the clathrin complex).")
AnnotationAssertion(rdfs:label obo:GO_0005575 "cellular_component")
EquivalentClasses(obo:GO_0005575 ObjectUnionOf(obo:GO_0032991 obo:GO_0044423 obo:GO_0110165))
SubClassOf(obo:GO_0005575 obo:BFO_0000040)

# Class: obo:GO_0008150 (biological process)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0008150 "A biological process is the execution of a genetically-encoded biological module or program. It consists of all the steps required to achieve the specific biological objective of the module. A biological process is accomplished by a particular set of molecular functions carried out by specific gene products (or macromolecular complexes), often in a highly regulated manner and in a particular temporal sequence.")
AnnotationAssertion(rdfs:label obo:GO_0008150 "biological process"@en)
SubClassOf(obo:GO_0008150 obo:BFO_0000015)
SubClassOf(obo:GO_0008150 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0003674))

# Class: obo:GO_0032991 (protein-containing complex)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0032991 "A stable assembly of two or more macromolecules, i.e. proteins, nucleic acids, carbohydrates or lipids, in which at least one component is a protein and the constituent parts function together.")
AnnotationAssertion(obo:IAO_0000116 obo:GO_0032991 "This is not covalently bonded, which conflicts with changes to the parent definition."@en)
AnnotationAssertion(rdfs:label obo:GO_0032991 "protein-containing complex")
SubClassOf(obo:GO_0032991 obo:COB_0000080)
SubClassOf(obo:GO_0032991 obo:GO_0005575)
SubClassOf(obo:GO_0032991 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000000001))

# Class: obo:GO_0044423 (virion component)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0044423 "Any constituent part of a virion, a complete fully infectious extracellular virus particle.")
AnnotationAssertion(rdfs:label obo:GO_0044423 "virion component")
SubClassOf(obo:GO_0044423 obo:GO_0005575)

# Class: obo:GO_0110165 (cellular anatomical entity)

AnnotationAssertion(obo:IAO_0000115 obo:GO_0110165 "A part of a cellular organism that is either an immaterial entity or a material entity with granularity above the level of a protein complex but below that of an anatomical system. Or, a substance produced by a cellular organism with granularity above the level of a protein complex.")
AnnotationAssertion(obo:IAO_0000116 obo:GO_0110165 "Components are larger than individual macromolecular entities. It is tricky to define distinction between 'cell component' and 'macromolecular entity', e.g. ribosome. We would like to exclude most protein complexes."@en)
AnnotationAssertion(obo:IAO_0000116 obo:GO_0110165 "Overlaps with some cellular components from GO"@en)
AnnotationAssertion(rdfs:label obo:GO_0110165 "cellular anatomical entity")
SubClassOf(obo:GO_0110165 obo:GO_0005575)
SubClassOf(obo:GO_0110165 obo:UBERON_0000465)
SubClassOf(obo:GO_0110165 ObjectSomeValuesFrom(obo:BFO_0000051 obo:COB_0000013))

# Class: obo:IAO_0000005 (objective specification)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000005 "A directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved."@en)
AnnotationAssertion(rdfs:label obo:IAO_0000005 "objective specification"@en)
SubClassOf(obo:IAO_0000005 obo:IAO_0000033)

# Class: obo:IAO_0000007 (action specification)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000007 "A directive information entity that describes an action the bearer will take."@en)
AnnotationAssertion(rdfs:label obo:IAO_0000007 "action specification"@en)
SubClassOf(obo:IAO_0000007 obo:IAO_0000033)

# Class: obo:IAO_0000027 (data item)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000027 "An information content entity that is intended to be a truthful statement about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en)
AnnotationAssertion(rdfs:label obo:IAO_0000027 "data item"@en)
SubClassOf(obo:IAO_0000027 obo:IAO_0000030)

# Class: obo:IAO_0000030 (information content entity)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000030 "A generically dependent continuant that is about some thing."@en)
AnnotationAssertion(obo:IAO_0000116 obo:IAO_0000030 "Pier: 'data, information or knowledge'. OR 'representation'"@en)
AnnotationAssertion(rdfs:label obo:IAO_0000030 "information content entity"@en)

# Class: obo:IAO_0000033 (directive information entity)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000033 "An information content entity whose concretizations indicate to their bearer how to realize them in a process."@en)
AnnotationAssertion(rdfs:label obo:IAO_0000033 "directive information entity"@en)
SubClassOf(obo:IAO_0000033 obo:IAO_0000030)

# Class: obo:IAO_0000104 (plan specification)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000104 "A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified."@en)
AnnotationAssertion(rdfs:label obo:IAO_0000104 "plan specification"@en)
SubClassOf(obo:IAO_0000104 obo:IAO_0000033)

# Class: obo:IAO_0000109 (measurement datum)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000109 "A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device."@en)
AnnotationAssertion(rdfs:label obo:IAO_0000109 "measurement datum"@en)
SubClassOf(obo:IAO_0000109 obo:IAO_0000027)

# Class: obo:MOP_0000543 (physico-chemical process)

AnnotationAssertion(obo:IAO_0000115 obo:MOP_0000543 "A process in which at least one of the participants is a molecule.")
AnnotationAssertion(obo:IAO_0000116 obo:MOP_0000543 "This is meant to capture processes that are more fundamental than macromolecular activities"@en)
AnnotationAssertion(rdfs:label obo:MOP_0000543 "physico-chemical process")
SubClassOf(obo:MOP_0000543 obo:BFO_0000015)

# Class: obo:NCBITaxon_10239 (virus)

AnnotationAssertion(rdfs:label obo:NCBITaxon_10239 "virus"@en)
SubClassOf(obo:NCBITaxon_10239 obo:COB_0000022)

# Class: obo:NCBITaxon_131567 (cellular organism)

AnnotationAssertion(rdfs:label obo:NCBITaxon_131567 "cellular organism")
SubClassOf(obo:NCBITaxon_131567 obo:COB_0000022)

# Class: obo:OBI_0000066 (investigation)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0000066 "a planned process that consists of parts: planning, study design execution, documentation and which produce conclusion(s)."@en)
AnnotationAssertion(rdfs:label obo:OBI_0000066 "investigation"@en)
SubClassOf(obo:OBI_0000066 obo:COB_0000035)

# Class: obo:OBI_0000070 (assay)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0000070 "A planned process that has the objective to produce information about a material entity (the evaluant) by examining it."@en)
AnnotationAssertion(rdfs:label obo:OBI_0000070 "assay"@en)
SubClassOf(obo:OBI_0000070 obo:COB_0000035)
SubClassOf(obo:OBI_0000070 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:OBI_0000293 obo:BFO_0000040) ObjectSomeValuesFrom(obo:OBI_0000299 obo:IAO_0000027)))

# Class: obo:OBI_0000260 (plan)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0000260 "A plan is a realizable entity that is the inheres in a bearer who is committed to realizing it as a completely executed planned process."@en)
AnnotationAssertion(rdfs:label obo:OBI_0000260 "plan"@en)
SubClassOf(obo:OBI_0000260 obo:BFO_0000017)
SubClassOf(obo:OBI_0000260 ObjectSomeValuesFrom(obo:RO_0000059 obo:IAO_0000104))

# Class: obo:OBI_0200000 (data transformation)

AnnotationAssertion(obo:IAO_0000115 obo:OBI_0200000 "A completely executed planned process that produces output data from input data."@en)
AnnotationAssertion(rdfs:label obo:OBI_0200000 "data transformation"@en)
SubClassOf(obo:OBI_0200000 obo:COB_0000035)
SubClassOf(obo:OBI_0200000 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:OBI_0000293 obo:IAO_0000027) ObjectSomeValuesFrom(obo:OBI_0000299 obo:IAO_0000027)))

# Class: obo:PATO_0000125 (mass)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000125 "A physical quality that inheres in a bearer by virtue of the proportion of the bearer's amount of matter.")
AnnotationAssertion(rdfs:label obo:PATO_0000125 "mass")
SubClassOf(obo:PATO_0000125 obo:COB_0000502)

# Class: obo:PATO_0002193 (electric charge)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0002193 "A molecular quality that inheres in a molecular entity by virtue of the overall electric charge of the molecule, which is due to a comparison between the total number of electrons and the total number of protons.")
AnnotationAssertion(rdfs:label obo:PATO_0002193 "electric charge")
SubClassOf(obo:PATO_0002193 obo:COB_0000502)

# Class: obo:PCO_0000000 (collection of organisms)

AnnotationAssertion(obo:IAO_0000115 obo:PCO_0000000 "A material entity that consists of two or more organisms, viruses, or viroids."@en)
AnnotationAssertion(rdfs:label obo:PCO_0000000 "collection of organisms"@en)
SubClassOf(obo:PCO_0000000 obo:BFO_0000040)
SubClassOf(obo:PCO_0000000 ObjectSomeValuesFrom(obo:BFO_0000051 obo:COB_0000022))

# Class: obo:PO_0025131 (plant anatomical entity)

AnnotationAssertion(obo:IAO_0000115 obo:PO_0025131 "An anatomical entity that is or was part of a plant.")
AnnotationAssertion(rdfs:label obo:PO_0025131 "plant anatomical entity")
SubClassOf(obo:PO_0025131 obo:UBERON_0000465)

