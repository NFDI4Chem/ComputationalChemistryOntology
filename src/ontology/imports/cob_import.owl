#   Classes
############################

# Class: obo:BFO_0000015 (process)

AnnotationAssertion(rdfs:label obo:BFO_0000015 "process"@en)

# Class: obo:BFO_0000016 (disposition)

AnnotationAssertion(rdfs:label obo:BFO_0000016 "disposition"@en)
SubClassOf(obo:BFO_0000016 obo:BFO_0000017)

# Class: obo:BFO_0000017 (realizable entity)

AnnotationAssertion(rdfs:label obo:BFO_0000017 "realizable entity"@en)
SubClassOf(obo:BFO_0000017 obo:COB_0000502)

# Class: obo:BFO_0000023 (role)

AnnotationAssertion(rdfs:label obo:BFO_0000023 "role"@en)
SubClassOf(obo:BFO_0000023 obo:BFO_0000017)

# Class: obo:BFO_0000029 (site)

AnnotationAssertion(rdfs:label obo:BFO_0000029 "site"@en)
SubClassOf(obo:BFO_0000029 obo:BFO_0000141)

# Class: obo:BFO_0000034 (function)

AnnotationAssertion(rdfs:label obo:BFO_0000034 "function"@en)
SubClassOf(obo:BFO_0000034 obo:BFO_0000016)

# Class: obo:BFO_0000040 (material entity)

AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000040 "Elucidation: An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en)
AnnotationAssertion(rdfs:label obo:BFO_0000040 "material entity"@en)

# Class: obo:BFO_0000141 (immaterial entity)

AnnotationAssertion(rdfs:label obo:BFO_0000141 "immaterial entity"@en)

# Class: obo:CHEBI_10545 (electron)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_10545 "Elementary particle not affected by the strong force having a spin 1/2, a negative elementary charge and a rest mass of 0.000548579903(13) u, or 0.51099906(15) MeV.")
AnnotationAssertion(rdfs:label obo:CHEBI_10545 "electron")
SubClassOf(obo:CHEBI_10545 obo:CHEBI_36342)

# Class: obo:CHEBI_24636 (proton)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_24636 "Nuclear particle of charge number +1, spin 1/2 and rest mass of 1.007276470(12) u.")
AnnotationAssertion(rdfs:label obo:CHEBI_24636 "proton")
SubClassOf(obo:CHEBI_24636 obo:CHEBI_36342)

# Class: obo:CHEBI_30222 (neutron)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_30222 "Nuclear particle of zero charge, spin 1/2 and rest mass of 1.008664904(14) u.")
AnnotationAssertion(rdfs:label obo:CHEBI_30222 "neutron")
SubClassOf(obo:CHEBI_30222 obo:CHEBI_36342)

# Class: obo:CHEBI_33252 (atomic nucleus)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_33252 "A nucleus is the positively charged central portion of an atom, excluding the orbital electrons.")
AnnotationAssertion(obo:IAO_0000116 obo:CHEBI_33252 "Some people may be uncomfortable calling every proton an atomic nucleus"@en)
AnnotationAssertion(obo:IAO_0000116 obo:CHEBI_33252 "This is equivalent to CHEBI:33252"@en)
AnnotationAssertion(rdfs:label obo:CHEBI_33252 "atomic nucleus")
SubClassOf(obo:CHEBI_33252 obo:CHEBI_36342)
SubClassOf(obo:CHEBI_33252 ObjectSomeValuesFrom(obo:BFO_0000051 obo:CHEBI_24636))

# Class: obo:CHEBI_36342 (subatomic particle)

AnnotationAssertion(obo:IAO_0000115 obo:CHEBI_36342 "A particle smaller than an atom.")
AnnotationAssertion(rdfs:label obo:CHEBI_36342 "subatomic particle")
SubClassOf(obo:CHEBI_36342 obo:BFO_0000040)
DisjointClasses(obo:CHEBI_36342 obo:COB_0000011)

# Class: obo:CL_0000000 (cell)

AnnotationAssertion(obo:IAO_0000115 obo:CL_0000000 "A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane.")
AnnotationAssertion(obo:IAO_0000116 obo:CL_0000000 "CL and GO definitions of cell differ based on inclusive or exclusive of cell wall, etc."@en)
AnnotationAssertion(obo:IAO_0000116 obo:CL_0000000 "We struggled with this definition. We are worried about circularity. We also considered requiring the capability of metabolism."@en)
AnnotationAssertion(rdfs:label obo:CL_0000000 "cell")
SubClassOf(obo:CL_0000000 obo:UBERON_0000465)

# Class: obo:COB_0000005 (obsolete elementary charge)

AnnotationAssertion(rdfs:label obo:COB_0000005 "obsolete elementary charge")
AnnotationAssertion(owl:deprecated obo:COB_0000005 "true"^^xsd:boolean)

# Class: obo:COB_0000011 (atom)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000011 "A material entity consisting of exactly one atomic nucleus and the electron(s) orbiting it."@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000011 "This atom is closely related to ChEBI's atom, but not exactly equivalent to."@en)
AnnotationAssertion(rdfs:label obo:COB_0000011 "atom"@en)
SubClassOf(obo:COB_0000011 obo:BFO_0000040)
SubClassOf(obo:COB_0000011 ObjectSomeValuesFrom(obo:BFO_0000051 obo:CHEBI_33252))
DisjointClasses(obo:COB_0000011 obo:COB_0000013)

# Class: obo:COB_0000013 (molecule)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000013 "A material entity that consists of two or more atoms that are all connected via covalent bonds such that any atom can be transitively connected with any other atom."@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000013 "This molecular entity is different than ChEBI's 'molecular entity'."@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000013 "We would like to have cardinality restrictions on the logic, but there are some technical limitations."@en)
AnnotationAssertion(rdfs:label obo:COB_0000013 "molecule"@en)
SubClassOf(obo:COB_0000013 obo:BFO_0000040)
SubClassOf(obo:COB_0000013 ObjectSomeValuesFrom(obo:BFO_0000051 obo:COB_0000011))

# Class: obo:COB_0000014 (obsolete macromolecular entity)

AnnotationAssertion(rdfs:label obo:COB_0000014 "obsolete macromolecular entity")
AnnotationAssertion(owl:deprecated obo:COB_0000014 "true"^^xsd:boolean)

# Class: obo:COB_0000020 (obsolete subcellular structure)

AnnotationAssertion(obo:IAO_0100001 obo:COB_0000020 obo:GO_0110165)
AnnotationAssertion(rdfs:label obo:COB_0000020 "obsolete subcellular structure")
AnnotationAssertion(owl:deprecated obo:COB_0000020 "true"^^xsd:boolean)

# Class: obo:COB_0000021 (gross anatomical part)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000021 "A part of a multicellular organism that is a collection of cell components that are not all contained in one cell."@en)
AnnotationAssertion(rdfs:label obo:COB_0000021 "gross anatomical part"@en)
SubClassOf(obo:COB_0000021 obo:UBERON_0000465)

# Class: obo:COB_0000022 (organism)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000022 "A material entity that is a maximal functionally integrated unit that develops from a program encoded in a genome"@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000022 "'Maximal functionally integrated unit' is intended to express unity, which Barry considers synonymous with BFO 'object'."@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000022 "Includes virus - we will later have a class for cellular organisms."@en)
AnnotationAssertion(rdfs:label obo:COB_0000022 "organism"@en)
SubClassOf(obo:COB_0000022 obo:UBERON_0000465)

# Class: obo:COB_0000026 (processed material entity)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000026 "A material entity processed by human activity with an intent to produce it."@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000026 "In the COB 2024 workshop there was much disagreement about this label."@en)
AnnotationAssertion(rdfs:label obo:COB_0000026 "processed material entity"@en)
SubClassOf(obo:COB_0000026 obo:BFO_0000040)
SubClassOf(obo:COB_0000026 ObjectSomeValuesFrom(obo:OBI_0000312 obo:COB_0000110))

# Class: obo:COB_0000032 (obsolete geographical location)

AnnotationAssertion(rdfs:label obo:COB_0000032 "obsolete geographical location")
AnnotationAssertion(owl:deprecated obo:COB_0000032 "true"^^xsd:boolean)

# Class: obo:COB_0000035 (completely executed planned process)

AnnotationAssertion(rdfs:label obo:COB_0000035 "completely executed planned process"@en)
SubClassOf(obo:COB_0000035 obo:COB_0000082)
SubClassOf(obo:COB_0000035 ObjectSomeValuesFrom(obo:BFO_0000055 obo:OBI_0000260))
DisjointClasses(obo:COB_0000035 obo:COB_0000083)

# Class: obo:COB_0000049 (nucleic acid chain)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000049 "A molecule that consists of nucleotides (unmodified nucleotide residues and/or modified nucleotide residues) linked by phosphodiester bonds or derivatives of such bonds."@en)
AnnotationAssertion(rdfs:label obo:COB_0000049 "nucleic acid chain"@en)
SubClassOf(obo:COB_0000049 obo:COB_0000013)

# Class: obo:COB_0000056 (obsolete immaterial anatomical entity)

AnnotationAssertion(obo:IAO_0100001 obo:COB_0000056 obo:UBERON_0000466)
AnnotationAssertion(rdfs:label obo:COB_0000056 "obsolete immaterial anatomical entity")
AnnotationAssertion(owl:deprecated obo:COB_0000056 "true"^^xsd:boolean)

# Class: obo:COB_0000073 (obsolete gene product)

AnnotationAssertion(rdfs:label obo:COB_0000073 "obsolete gene product")
AnnotationAssertion(owl:deprecated obo:COB_0000073 "true"^^xsd:boolean)

# Class: obo:COB_0000077 (obsolete action specification)

AnnotationAssertion(obo:IAO_0100001 obo:COB_0000077 obo:IAO_0000007)
AnnotationAssertion(rdfs:label obo:COB_0000077 "obsolete action specification")
AnnotationAssertion(owl:deprecated obo:COB_0000077 "true"^^xsd:boolean)

# Class: obo:COB_0000080 (complex of molecules)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000080 "A complex of two or more molecules that are not covalently bound."@en)
AnnotationAssertion(rdfs:label obo:COB_0000080 "complex of molecules"@en)
SubClassOf(obo:COB_0000080 obo:BFO_0000040)
SubClassOf(obo:COB_0000080 ObjectSomeValuesFrom(obo:BFO_0000051 obo:COB_0000013))

# Class: obo:COB_0000082 (planned process)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000082 "A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification."@en)
AnnotationAssertion(rdfs:label obo:COB_0000082 "planned process"@en)
SubClassOf(obo:COB_0000082 obo:BFO_0000015)

# Class: obo:COB_0000083 (failed planned process)

AnnotationAssertion(rdfs:label obo:COB_0000083 "failed planned process"@en)
SubClassOf(obo:COB_0000083 obo:COB_0000082)

# Class: obo:COB_0000110 (material processing)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000110 "A completely executed planned process that intends to output material entities from input material entities"@en)
AnnotationAssertion(rdfs:label obo:COB_0000110 "material processing"@en)
SubClassOf(obo:COB_0000110 obo:COB_0000035)
SubClassOf(obo:COB_0000110 ObjectIntersectionOf(ObjectSomeValuesFrom(obo:OBI_0000293 obo:BFO_0000040) ObjectSomeValuesFrom(obo:OBI_0000299 obo:BFO_0000040)))

