############################
#   Annotation Properties
############################

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")

# Annotation Property: cocho:hasMolecularMechanics (There is Molecular Mechanical Calculation)

AnnotationAssertion(rdfs:comment cocho:hasMolecularMechanics "A property that says (true/false) if there is MM calculation"@en)
AnnotationAssertion(rdfs:label cocho:hasMolecularMechanics "There is Molecular Mechanical Calculation"@en)

# Annotation Property: cocho:hasQuantumMechanics (There is Quantum Mechanical Calculation)

AnnotationAssertion(rdfs:comment cocho:hasQuantumMechanics "A property that says (true/false) if there is QM calculation"@en)
AnnotationAssertion(rdfs:label cocho:hasQuantumMechanics "There is Quantum Mechanical Calculation"@en)

# Annotation Property: cocho:isAbstract (is abstract)

AnnotationAssertion(rdfs:comment cocho:isAbstract "This annotation should be used to mark entities as abstract.
    Abstract entity is a defined OWL resource that from a data model should never be defined explicitly.

    NOTE!
    Since it's only a annotation property, it doesn't impact a logical definition of an Entity. Such a property should be treated as a \"side note\". "@en)
AnnotationAssertion(rdfs:isDefinedBy cocho:isAbstract <http://chemicalsemantics.com/>)
AnnotationAssertion(rdfs:label cocho:isAbstract "is abstract"@en)

# Annotation Property: cocho:termStatus (term status)

AnnotationAssertion(rdfs:comment cocho:termStatus "Such a annotation contains information about defined in DMS ontology Axiom status.
    Since it's a text based value, follwing enumerations should be used as values:

    - STABLE (Entity was tested during QA process and is stable)
    - UNSTABLE (Entity is unstable due to some reasone - shouldn't be use till fixed)
    - TESTING (Entity is under testing process)
    - ARCHAIC (old and unused definition - probably will be removed in comming iterations)
    - DEPRECATED (Entity is deprecated due to some reason - should not be used)
    - NEW (new definition)
    - FIX (definition that was made to bring fix for some issue)

    NOTE!
    Since it's only a annotation property, it doesn't impact a logical definition of an Entity. Such a property should be treated as a \"side note\". "@en)
AnnotationAssertion(rdfs:isDefinedBy cocho:termStatus <http://chemicalsemantics.com/>)
AnnotationAssertion(rdfs:label cocho:termStatus "term status"@en)

# Annotation Property: cocho:termStatusNote (term status note)

AnnotationAssertion(rdfs:comment cocho:termStatusNote "This property is a status description of a particular Entity. Combined with log:termStatus contains information aboud current status of an Entity, with a information about history, changes, etc.

    NOTE!
    Since it's only a annotation property, it doesn't impact a logical definition of an Entity. Such a property should be treated as a \"side note\". "@en)
AnnotationAssertion(rdfs:isDefinedBy cocho:termStatusNote <http://chemicalsemantics.com/>)
AnnotationAssertion(rdfs:label cocho:termStatusNote "term status note"@en)


